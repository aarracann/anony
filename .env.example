# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Secret salt for hashing IPs and device fingerprints (SHA-256)
HASH_SALT=change-me-to-a-random-secure-string-at-least-32-chars

# Push notification (Firebase Cloud Messaging - optional stub)
FCM_SERVER_KEY=
